<!--
  Charis Vercel Threat Detection Rules for Wazuh SIEM
  Mapped to MITRE ATT&CK Framework for SOC Analyst Portfolio
-->

<group name="vercel,web,cloud_security,">

  <!-- Base Event: Normal Edge Traffic -->
  <rule id="100001" level="3">
    <decoded_as>vercel-edge</decoded_as>
    <description>Charis Edge: Routine HTTP request processed by Vercel</description>
    <mitre>
      <id>T1071.001</id>
    </mitre>
  </rule>

  <!-- Sensitive Configuration File Probing -->
  <rule id="100030" level="9">
    <if_sid>100001</if_sid>
    <match>/.env|/.git|/wp-config|/id_rsa|/config.json|/aws/credentials</match>
    <description>Charis Edge: Sensitive environment or credential probe detected ($(url))</description>
    <mitre>
      <id>T1083</id>
      <id>T1552.001</id>
    </mitre>
  </rule>

  <!-- Automated Security Scanner / Tool User-Agent -->
  <rule id="100020" level="8">
    <if_sid>100001</if_sid>
    <match>nikto|sqlmap|nmap|masscan|gobuster|dirbuster|ffuf|hydra|wpscan</match>
    <description>Charis Edge: Security scanning tool or automated fuzzing agent detected ($(extra_data))</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
  </rule>

  <!-- Cross-Site Scripting (XSS) or Injection Pattern -->
  <rule id="100040" level="9">
    <if_sid>100001</if_sid>
    <match>&lt;script|%3Cscript|onload=|javascript:|onerror=</match>
    <description>Charis Edge: Potential Cross-Site Scripting (XSS) probe pattern in URL ($(url))</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- Directory Traversal Probing -->
  <rule id="100060" level="10">
    <if_sid>100001</if_sid>
    <match>../|..%2f|/etc/passwd|/windows/win.ini</match>
    <description>Charis Edge: Path traversal attack pattern detected ($(url))</description>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- Rate Limiting / DoS Threshold (HTTP 429 Frequency) -->
  <rule id="100050" level="11" frequency="6" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <match>status="429"</match>
    <same_source_ip />
    <description>Charis Edge: High-frequency rate limit exhaustion / potential DoS flood from $(srcip)</description>
    <mitre>
      <id>T1499.003</id>
    </mitre>
  </rule>

  <!-- Active Directory Brute-Force / Discovery (Excessive 404s) -->
  <rule id="100010" level="8" frequency="8" timeframe="30">
    <if_matched_sid>100001</if_matched_sid>
    <match>status="404"</match>
    <same_source_ip />
    <description>Charis Edge: Potential content discovery / directory brute force attack from $(srcip)</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
  </rule>

</group>
