# ==============================================================================
# Charis PWA — Environment Variables Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' for local development.
#
# IMPORTANT SECURITY NOTICE:
# - NEVER place the Supabase 'service_role' key or any private secret in this file.
# - Vite bundles all 'VITE_*' variables directly into public client-side JavaScript.
# - Only provide public credentials here.
# ==============================================================================

# Supabase Project Configuration (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Optional: Public App URL for OAuth redirects (e.g. Google Sign-In)
# Defaults to window.location.origin during local development.
VITE_PUBLIC_SITE_URL=http://localhost:5173
